{
  "name": "dogfile",
  "productName": "Dogfile",
  "version": "2.2.0",
  "description": "A power-user file manager for Windows with tabs, 4-pane split view, previews, tags and more. The app is Tauri + Rust (app/, backend/, core/); this file only lists the JavaScript libraries that are bundled into src/renderer/vendor.",
  "author": "Dogfile",
  "license": "MIT",
  "scripts": {
    "vendor:office": "esbuild build/vendor-src/office.js --bundle --format=esm --minify --legal-comments=eof --outfile=src/renderer/vendor/office.js --define:process.env.NODE_ENV='\"production\"' --inject:build/vendor-src/buffer-shim.js"
  },
