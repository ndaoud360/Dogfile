+
+
+/* Free utilities */
+.util-modal .modal-body { max-height: min(78vh, 860px); overflow: auto; }
+.util-hub { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
+.util-hub > .hint { grid-column: 1 / -1; margin: 0 0 2px; }
+.util-card { min-width: 0; padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-2); display: flex; flex-direction: column; gap: 10px; }
+.util-card-head { display: flex; align-items: center; gap: 10px; min-height: 38px; }
+.util-card-head b { display: block; font-size: 14px; }
+.util-card-head .hint { margin-top: 2px; }
+.util-icon { width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center; border-radius: 9px; background: var(--surface-3); color: var(--accent); font-size: 20px; }
+.util-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
+.util-label { font-size: 12px; color: var(--text-2); font-weight: 600; }
+.util-field .hint { font-size: 11px; }
+.util-area { min-height: 72px; resize: vertical; }
+.util-actions { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
+.util-actions > .input { flex: 1; min-width: 0; }
+.util-status { min-height: 16px; overflow-wrap: anywhere; }
+.util-error { color: var(--danger, #e05b62) !important; }
+.util-preview { min-height: 100px; display: grid; place-items: center; border: 1px dashed var(--line); border-radius: 9px; background: var(--surface); padding: 10px; }
+.util-qr-img { width: min(100%, 190px); height: auto; image-rendering: pixelated; }
+.util-palette { display: flex; gap: 6px; flex-wrap: wrap; }
+.util-swatch { flex: 1 1 68px; min-width: 68px; border: 1px solid var(--line); border-radius: 8px; padding: 28px 5px 7px; color: #fff; text-shadow: 0 1px 3px #000; text-align: left; cursor: pointer; display: flex; flex-direction: column; gap: 2px; font-size: 11px; }
+.util-swatch small { font-size: 10px; opacity: .9; }
+.util-cover-preview { overflow: hidden; border-radius: 9px; border: 1px solid var(--line); }
+.util-cover-preview img { display: block; width: 100%; height: auto; }
+.util-card .input { width: 100%; }
+@media (max-width: 760px) {
+  .util-hub { grid-template-columns: 1fr; }
+  .util-modal { width: min(96vw, 560px) !important; }
+}
